{
  "name": "@local/life-grid",
  "version": "1.0.0",
  "private": true,
  "description": "Life Grid for the DeepSeek Harness Web UI: an annual nine-grid planner following 《只管去做》(邹小强)'s eight-area method, with per-area goals, five-year vision, focus areas, per-year data and JSON export/import.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
