{
  "name": "@local/knowledge-tree",
  "version": "2.0.1",
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test ../tests/knowledge*.test.js ../tests/library.test.js ../tests/workspace-ui.test.js tests/github-sync.test.js"
  },
  "private": true,
  "description": "Knowledge Tree for DSH: list, classify and grow multiple local knowledge trees, compare GitHub snapshots, and manually Push/Pull with conflict protection. IndexedDB storage and Markdown / Mermaid / JSON export.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-service.js",
    "github-sync.js",
    "client.js",
    "library.js",
    "workspace-ui.js",
    "build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
