{
  "name": "@local/session-watch",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "description": "关注会话工作台：跨工作区关注、实时卡片及原生双屏／四宫格会话，支持输入与审批。",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js",
    "prepack": "node build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "core.js",
    "shortcuts.js",
    "host-state.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
